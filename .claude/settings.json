{
  "permissions": {
    "allow": [
      "Read", "Write", "Edit", "Grep", "Glob",
      "Bash(git status:*)", "Bash(git diff:*)", "Bash(git add:*)", "Bash(git commit:*)", "Bash(git push:*)", "Bash(git log:*)",
      "Bash(npm run build:*)", "Bash(npm run lint:*)", "Bash(npm test:*)", "Bash(npm run format:*)",
      "Bash(date:*)", "Bash(sha1sum:*)"
    ],
    "deny": ["Bash(rm -rf:*)"],
    "additionalDirectories": ["../"]
  }
}
